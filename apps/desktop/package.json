{
  "name": "office-agent-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:windows": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-windows.ps1",
    "build:macos": "bash ../../scripts/build-macos.sh",
    "test": "vitest run",
    "check:licenses": "license-checker --production --summary --failOn \"GPL;AGPL;GNU General Public License;GNU Affero General Public License;GNU General Public License v2;GNU General Public License v3;GNU Affero General Public License v3\"",
    "licenses:list": "license-checker --production --csv"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "license-checker": "^25.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
